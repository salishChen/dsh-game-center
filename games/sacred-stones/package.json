{
  "name": "@dsh-games/sacred-stones",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "火焰纹章 圣魔之光石 网页复刻（从 ROM 逆向重写，不打包 ROM）",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:kernels": "node --test test/kernel-integration.test.mjs",
    "build": "node scripts/build.mjs && node scripts/check-dist.mjs",
    "digest": "node scripts/digest.mjs",
    "build:verify": "node scripts/build.mjs && node scripts/check-dist.mjs && git diff --exit-code -- games/sacred-stones/dist",
    "pretest": "node scripts/verify-mask-pack-copy.mjs",
    "verify:mask-pack": "node scripts/verify-mask-pack-copy.mjs"
  },
  "dependencies": {
    "@gba-kit/arm-emulator": "0.8.0",
    "@gba-kit/gba-emulator": "0.8.0"
  }
}
