{
  "name": "@dsh-gamecenter/client",
  "version": "0.0.0",
  "private": true,
  "description": "DSH 游戏中心 Client 插件：DSH 内入口与弹层、游戏中心状态、隔离 iframe 运行时与专用 MessagePort Bridge。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/types/index.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@dsh-gamecenter/protocol": "workspace:*"
  },
  "files": [
    "dist",
    "lib/index.js",
    "lib/index.d.ts",
    "src/types",
    "package.json"
  ],
  "scripts": {
    "build": "node tools/build-bundle.mjs",
    "build:candidate": "node tools/build-candidate.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-timeout=15000 test/*.test.mjs"
  },
  "license": "UNLICENSED"
}
